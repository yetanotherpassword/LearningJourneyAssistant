# Copy to .env and fill in. .env is gitignored — never commit a real token.

# Base URL of the local Moodle instance (no trailing slash). devenv/env.sh
# defaults MOODLE_DOCKER_WEB_PORT to 8081, not 8000 -- check env.sh for your
# team's actual port before assuming this default is right.
MOODLE_URL=http://localhost:8081

# Web service token: Site admin -> Server -> Web services -> Manage tokens.
# Use the least-privilege service account, not the admin account.
MOODLE_TOKEN=

# Read-only Postgres role for the direct-DB queries in the SQL bundle
PGHOST=localhost
PGPORT=5432
PGDATABASE=moodle
PGUSER=lja_reader
PGPASSWORD=

# --- LLM layer (lja/llm/) --------------------------------------------------
# "anthropic" or "openai_compatible". Defaults to openai_compatible so a
# fresh checkout works with zero cost against a local LM Studio/Ollama
# instance -- see python/README.md's LLM layer section.
LJA_LLM_PROVIDER=openai_compatible

# Anthropic backend
ANTHROPIC_API_KEY=
LJA_ANTHROPIC_MODEL=claude-opus-4-8
# claude-opus-4-8 REJECTS temperature/top_p/top_k (400 error) -- these are
# the actual tuning knobs on this model family. Empty = let the API default
# (equivalent to "high"). See python/README.md's LLM-tuning section.
LJA_ANTHROPIC_EFFORT=
LJA_ANTHROPIC_THINKING=false

# OpenAI-compatible backend -- any server implementing /v1/chat/completions.
# LM Studio default: http://localhost:1234/v1
# Ollama default:    http://localhost:11434/v1  (note the /v1 suffix)
# Model: tested live against the real dataset -- an 8B model (gemma4) fails
# the SILO clustering task outright, a 30B model (qwen3-vl) does it
# correctly. See python/README.md before swapping this for something smaller.
LJA_OPENAI_BASE_URL=http://localhost:11434/v1
LJA_OPENAI_MODEL=qwen3-vl:30b
LJA_OPENAI_API_KEY=not-needed
# Standard sampling temperature -- Ollama/LM Studio actually honour this
# (unlike the Anthropic path above). Kept low: this is a classification
# task, not creative writing.
LJA_OPENAI_MAX_TOKENS=16000
LJA_OPENAI_TEMPERATURE=0.2
