classDiagram
    direction LR

    class LjaDataset {
        +dict~str,Silo~ silos
        +list~Assessment~ assessments
        +list~ResultRow~ results
        +list~StudentSummary~ student_summaries
    }
    class Silo {
        +subject_code
        +silo_local_id
        +text
        +key() "SUBJ:SILOn"
    }
    class Assessment {
        +subject_code
        +assessment_name
        +weight
        +silo_ids
    }
    class ResultRow {
        +student_id
        +subject_code
        +assessment_name
        +score
        +feedback_comment
        +silo_ids
    }
    class StudentSummary {
        +student_id
        +subject_totals
        +average_total
        +performance_band
    }
    LjaDataset *-- Silo
    LjaDataset *-- Assessment
    LjaDataset *-- ResultRow
    LjaDataset *-- StudentSummary

    class LLMClient {
        <<Protocol>>
        +complete_structured(system, user, schema) T
        +describe() str
        +usage_summary() str
    }
    class AnthropicClient
    class OpenAICompatibleClient
    LLMClient <|.. AnthropicClient
    LLMClient <|.. OpenAICompatibleClient

    class SiloClusteringResult {
        +list~CompetencyCluster~ clusters
        +list~FlaggedSilo~ flagged_silos
    }
    class CompetencyCluster {
        +competency_label
        +rationale
        +list~SiloRef~ members
    }
    SiloClusteringResult *-- CompetencyCluster

    class GapThresholds {
        +absolute_floor 50
        +absolute_ceiling 75
        +relative_gap_cutoff -1.0
        +relative_strong_cutoff 1.0
        +min_competencies 4
        +min_spread 1.0
        +fallback_proficient 65
    }
    class CompetencyGap {
        +student_id
        +competency_label
        +attainment_pct
        +subjects_evidencing
        +classification
        +classification_basis
        +relative_position
    }

    class ReviewStore {
        +version
        +dict~str,ClusterReview~ reviews
    }
    class ClusterReview {
        +cluster_id sha256[:12]
        +competency_label
        +members
        +state pending|confirmed|rejected
        +note
    }
    ReviewStore *-- ClusterReview

    class SubjectSequence {
        +declared tuple
        +position(code) SequencePosition
        +from_config()
    }
    class Trajectory {
        +points TrajectoryPoint[]
        +delta
        +label
        +basis declared|year digit|mixed|none
        +taken() ahead()
    }
    class SubjectQuality {
        +subject_code
        +health
        +gap_rate
        +issues
    }

    class PlanContext {
        +competencies
        +silo_text
        +assessments
        +known_*()
    }
    class LearningPlan {
        +student_id
        +summary
        +list~PlanPriority~ priorities
        +strengths_to_build_on
    }
    class StudyStrategy {
        +student_id
        +list~StrategyEntry~ entries
        +techniques from a closed list
    }
    class QuizDocument {
        +quiz Quiz
        +educator_review EducatorReview
        +disagreements()
    }
    class QuizItem {
        +kind multiple_choice|written
        +competency_label silo_key assessment_key
        +options correct_index
        +model_answer marking_points
    }
    QuizDocument *-- QuizItem
    class GroundingReport {
        +artefact
        +problems
        +ok
        +raise_if_failed()
    }
    class ReferenceCheck {
        +kind
        +referenced
        +known
        +require_complete
        +require_unique
    }

    class Generator {
        +GenerateConfig config
        +start(kind, student_id) Job
        +status(kind, student_id) Job
        +command(kind, student_id) list
    }
    class Job {
        +kind student_id command
        +state running|done|failed
        +lines
        +returncode
    }
    Generator *-- Job
    class RunInfo {
        +command started_at code_version
        +excel_path clustering_cache review_file
        +environment
    }

    LjaDataset --> SiloClusteringResult : cluster_silos(client, dataset)
    SiloClusteringResult --> ReviewStore : load_or_create_reviews()
    LjaDataset --> CompetencyGap : compute_gaps(dataset, clustering, thresholds)
    GapThresholds --> CompetencyGap
    CompetencyGap --> Trajectory : compute_trajectory()
    SubjectSequence --> Trajectory
    LjaDataset --> SubjectQuality : assess_silos()
    CompetencyGap --> PlanContext : build_plan_context()
    PlanContext --> LearningPlan : generate_learning_plan(client)
    PlanContext --> StudyStrategy : generate_strategy(client)
    PlanContext --> QuizDocument : generate_quiz() then review_quiz()
    LearningPlan ..> GroundingReport : validate_plan()
    StudyStrategy ..> GroundingReport : validate_strategy()
    QuizDocument ..> GroundingReport : validate_quiz() validate_review()
    SiloClusteringResult ..> GroundingReport : _validate_coverage()
    ReferenceCheck --> GroundingReport
    Generator ..> LearningPlan : subprocess lja.plan
    Generator ..> QuizDocument : subprocess lja.quiz
